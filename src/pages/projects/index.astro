---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/page-hero.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import ContactBlock from '../../components/contact-block.astro';
import {projects,projectsPageTitle,projectsPageLead,ui,company,projectHref} from '../../data';
import {pageui} from '../../data/ui';
---
<BaseLayout title={`${ui.nav.projects} — ${company.name.text}`} description={pageui.projectsmeta}>
  <PageHero title={projectsPageTitle.text} eyebrow={company.descriptor.text} />
  <section class="container page-section page-section--flush" aria-label={pageui.catalog}>
    <div class="projects-intro"><p>{projectsPageLead.text}</p><span class="project-count">{pageui.projectcount}</span></div>
    <ul class="project-catalog" role="list">{projects.map((project)=><ProjectCard level={2} title={project.title.text} href={projectHref(project) ?? undefined} />)}</ul>
  </section>
  <ContactBlock />
</BaseLayout>
