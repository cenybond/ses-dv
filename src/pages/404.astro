---
// Страница 404 (решение владельца 2026-11-18): отдельная страница без шапки и подвала, фон #141A15, фраза и кнопка по центру сверху,
// графика «404» из Figma (файл vnzVAkzaxq8GFCf6tV89DL, узел 50:543) на всю ширину внизу — целиком, без обрезки.
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import art from '../assets/404/404.svg?raw';
import { ui, company } from '../data';
import { pageui } from '../data/ui';
import '../styles/not-found.css';
// Инлайн-SVG в HTML не нуждается в xmlns (адрес пространства имён проверки check-copy считает внешней ссылкой).
const inlineArt = art.replace(/\sxmlns(?::\w+)?="[^"]*"/g, '');
---
<BaseLayout bare title={`${ui.notFound.title} — ${company.name.text}`} description={pageui.errormeta}>
  <div class="not-found">
    <div class="not-found__top">
      <h1 class="not-found__title">{ui.notFound.heading}</h1>
      <Button href="/" size="lg">{ui.notFound.back}</Button>
    </div>
    <div class="not-found__art" aria-hidden="true" set:html={inlineArt} />
  </div>
</BaseLayout>
