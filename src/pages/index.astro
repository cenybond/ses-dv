---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/hero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ContactForm from '../components/contact-form.astro';
import { company, hero, services, getHomeProjects, getHomeAdvantages, ui } from '../data';
import '../styles/home.css';
import '../styles/pages.css';
const selected = [services[0], services[1], services[4], services[5], services[8], services[9]];
---
<BaseLayout title="Связь Энергострой — проектирование и строительство инженерных сетей" description={company.descriptor.text + '. Услуги, проекты и контакты ООО «Связь Энергострой».'} headerVariant="overlay">
  <Hero />
  <section class="section" aria-labelledby="home-services">
    <div class="container">
      <header class="section__head"><div><p class="eyebrow">Направления деятельности</p><h2 class="h-section" id="home-services">Наши услуги</h2></div><a class="link-inline" href="/services">Все направления <span aria-hidden="true">↗</span></a></header>
      <ul class="home-services">
        {selected.map((service) => <li><a href={'/services#' + service.id}><span class="home-services__number" aria-hidden="true">{service.id.slice(2)}</span><h3>{service.title.text}</h3><span class="home-services__arrow" aria-hidden="true">↗</span></a></li>)}
      </ul>
    </div>
  </section>
  <section class="section" aria-labelledby="home-about">
    <div class="container home-about">
      <div><p class="eyebrow">О компании</p><h2 class="h-section" id="home-about">{company.name.text}</h2><a class="link-inline" href="/about">{ui.actions.aboutMore} <span aria-hidden="true">↗</span></a></div>
      <div><p class="home-about__lead">{company.lead.text}</p><p class="home-about__detail">{hero.lines[2].text}</p></div>
    </div>
  </section>
  <section class="section" aria-labelledby="home-projects">
    <div class="container">
      <header class="section__head"><div><p class="eyebrow">Опыт компании</p><h2 class="h-section" id="home-projects">Проекты</h2></div><a class="link-inline" href="/projects">{ui.actions.allProjects} <span aria-hidden="true">↗</span></a></header>
      <ul class="projects home-projects">{getHomeProjects().map(project => <ProjectCard title={project.title.text} href={'/projects/' + project.slug} />)}</ul>
    </div>
  </section>
  <section class="section" aria-labelledby="home-advantages">
    <div class="container home-advantages">
      <h2 class="h-section" id="home-advantages">Почему СЭС</h2>
      <ol>{getHomeAdvantages().map((advantage, index) => <li><span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span><h3>{advantage.title.text}</h3></li>)}</ol>
    </div>
  </section>
  <section class="section section--cta" id="request" aria-label="Обращение в компанию">
    <div class="container"><ContactForm context="home" heading={ui.cta.heading} /></div>
  </section>
</BaseLayout>
