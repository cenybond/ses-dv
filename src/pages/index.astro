---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/hero.astro';
import ProjectsGallery from '../components/ProjectsGallery.astro';
import ClientsMarquee from '../components/ClientsMarquee.astro';
import ContactForm from '../components/contact-form.astro';
import { company, services, getHomeAboutAdvantages, ui } from '../data';
import { Picture } from 'astro:assets';
import videoSurveillance from '../assets/services/video-surveillance.webp';
import powerGrids from '../assets/services/power-grids.webp';
import gnb from '../assets/services/gnb.webp';
import design from '../assets/services/design.webp';
import geodesy from '../assets/services/geodesy.webp';
import linear from '../assets/services/linear.webp';
import { glue } from '../utils/typography';
import '../styles/home.css';
import '../styles/pages.css';
// Порядок = расстановка в сетке (home.css): малая, малая, широкая, высокая в центре, широкая, малая, малая.
// Фото на карточках услуг (по id услуги). Права на снимки подтверждает владелец (Q-10).
const cardPhotos: Record<string, ImageMetadata> = { 's-04': videoSurveillance, 's-02': powerGrids, 's-05': gnb, 's-10': design, 's-06': geodesy, 's-01': linear };
const byId = (id: string) => services.find((service) => service.id === id)!;
// Карточки услуг плавно ведут к блоку обращения внизу страницы (data-request-open, src/scripts/forms.ts, решение владельца 2026-11-18).
// Последняя карточка — не услуга, а вход в полный перечень (подпись интерфейса): открывает окно со всеми услугами.
const selected = [
  ...['s-10', 's-06', 's-05', 's-01', 's-02', 's-04'].map(byId).map((service) => ({ id: service.id, title: service.title.text })),
  { id: '', title: 'Подробный перечень услуг' },
];
---
<BaseLayout title="Связь Энергострой — проектирование и строительство инженерных сетей" description={company.descriptor.text + '. Услуги, проекты и контакты ООО «Связь Энергострой».'} headerVariant="hero">
  <Hero />
  <div class="home-rest">
  <section class="home-about" aria-labelledby="home-about-title">
    <div class="container home-about__grid">
      <h2 class="h-section home-about__title" id="home-about-title">{ui.homeAbout.heading}</h2>
      <p class="home-about__lead">{ui.homeAbout.leadPrefix} {company.lead.text}</p>
      <ul class="home-about__list">{getHomeAboutAdvantages().map((advantage) => <li><span>{advantage.title.text}</span></li>)}</ul>
    </div>
  </section>
  <ClientsMarquee />
  <section class="section" aria-labelledby="home-services">
    <div class="container">
      <header class="section__head"><h2 class="h-section home-services__title" id="home-services">Наши услуги</h2></header>
      <ul class="home-services">
        {selected.map((card, index) => <li><button class:list={['home-services__card', card.id in cardPhotos && 'home-services__card--photo']} type="button" {...(card.id ? { 'data-request-open': '' } : { 'aria-haspopup': 'dialog', 'data-modal-open': 'list-modal-services' })}>{card.id in cardPhotos && <Picture class="home-services__photo" src={cardPhotos[card.id]} alt="" formats={['avif', 'webp']} fallbackFormat="jpeg" widths={[320, 640]} sizes="(max-width: 640px) 100vw, 20vw" loading="lazy" decoding="async" />}<h3>{glue(card.title, [0, 1, 5, 6].includes(index))}</h3><span class="home-services__arrow" aria-hidden="true"><svg viewBox="0 0 20 20" width="20" height="20" focusable="false"><path d="M5 15 15 5M7 5h8v8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg></span></button></li>)}
      </ul>
    </div>
  </section>
  <dialog class="list-modal" id="list-modal-services" aria-labelledby="list-modal-services-title">
    <div class="list-modal__scroll" data-lenis-prevent>
      <div class="list-modal__inner">
        <header class="list-modal__head">
          <h2 id="list-modal-services-title">Наши услуги</h2>
          <button class="list-modal__close" type="button" data-modal-close aria-label={ui.a11y.close}>
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
          </button>
        </header>
        <ul class="list-modal__list">
          {services.map((service) => <li data-service={service.id}><span>{service.title.text}</span></li>)}
        </ul>
      </div>
    </div>
  </dialog>
  <ProjectsGallery />
  <section class="section section--cta home-cta" id="request" aria-label="Обращение в компанию">
    <div class="container home-cta__pin"><ContactForm context="home" heading={ui.cta.heading} variant="line" /></div>
  </section>
  </div>
  <script>
    import '../scripts/cta-pin.ts';
    import '../scripts/home-nav.ts';
    import '../scripts/list-modal.ts';
  </script>
</BaseLayout>
