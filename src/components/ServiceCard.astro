---
import RequestButton from './request-button.astro';
import {pageui} from '../data/ui';
interface Props { number:string; title:string; descriptionPending?:boolean; id?:string; level?:2|3 }
const {number,title,descriptionPending=false,level=3,id=`s-${number.padStart(2,'0')}`} = Astro.props;
---
<li class="service-entry" id={id}>
  <span class="service-entry__number" aria-hidden="true">{number}</span>
  {level===2?<h2>{title}</h2>:<h3>{title}</h3>}
  {descriptionPending && <p class="service-entry__note">{pageui.designnote}</p>}
  <div class="service-entry__actions"><RequestButton context={`service:${id}`} label={pageui.servicelink} /></div>
</li>
