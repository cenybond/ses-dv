---
import { site_config } from '../data/site-config';
import '../styles/privacy.css';
---
<aside class="cookie-banner" aria-label="Настройки аналитики" data-cookie-banner data-analytics-available={String(site_config.analytics_enabled)} data-metrica-id={site_config.metrica_id || ''} data-site-origin={site_config.origin} hidden>
  <div>
    <h2>Аналитика — с вашего разрешения</h2>
    <p>Яндекс Метрика помогает понять, как используют сайт. Вы можете разрешить её или продолжить без аналитики. <a href="/cookies">О технологиях хранения</a></p>
  </div>
  <div class="cookie-actions">
    <button type="button" class="btn btn--secondary" data-cookie-accept>Разрешить аналитику</button>
    <button type="button" class="btn btn--secondary" data-cookie-reject>Без аналитики</button>
    <button type="button" class="cookie-link" data-cookie-open>Настроить</button>
  </div>
</aside>
<p class="cookie-status" role="status" data-cookie-status></p>
<script>
  import { init_consent } from '../scripts/consent';
  import { init_analytics } from '../scripts/analytics';
  init_consent();
  init_analytics();
</script>
