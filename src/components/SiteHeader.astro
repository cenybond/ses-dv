---
// Шапка (DESIGN-SYSTEM §8.1). `solid` — внутренние страницы без hero: светлая всегда; `overlay` — прозрачная над hero (главная, DEMO-06).
// Кнопка «Заказать звонок» и шторка меню появятся с диалогами (DEMO-05): до этого бургер — якорь на навигацию в подвале (работает без JS).
import Logo from './Logo.astro';
import ContactLink from './ContactLink.astro';
import { phones, ui, mainNav } from '../data';

interface Props {
  variant?: 'solid' | 'overlay';
  currentPath?: string;
}
const { variant = 'solid', currentPath = '' } = Astro.props;
---
<header class="site-header" id="top" data-header={variant === 'solid' ? 'solid' : ''}>
  <div class="container site-header__row">
    <Logo variant="wordmark" />
    <nav class="nav" aria-label={ui.a11y.mainNav}>
      <ul>
        {mainNav.map((item) => (
          <li><a href={item.href} aria-current={currentPath === item.href ? 'page' : undefined}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
    <div class="site-header__actions">
      <ContactLink class="header-phone" href={phones[0].href} label={phones[0].display.text} />
      <a class="burger" href="#site-nav" data-open-menu aria-label={ui.a11y.menu} aria-haspopup="dialog">
        <span class="burger__bars" aria-hidden="true"></span>
      </a>
    </div>
  </div>
</header>
