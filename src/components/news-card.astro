---
import type { news_entry } from '../data/publications';
import '../styles/pages.css';
interface Props { item: news_entry; }
const { item } = Astro.props;
const date = new Date(item.published_on + 'T00:00:00Z').toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---
<li class="service-entry">
  {item.image && <figure class="project-card__photo"><img src={item.image.src} alt={item.image.alt} width={item.image.width} height={item.image.height} loading="lazy" decoding="async" /></figure>}
  <time class="service-entry__number" datetime={item.published_on}>{date}</time>
  <h2><a href={`/news/${item.slug}`}>{item.title}</a></h2>
  <p>{item.summary}</p>
  <div class="service-entry__actions"><a class="page-inline-link" href={`/news/${item.slug}`}>Читать новость <span aria-hidden="true">↗</span></a></div>
</li>
