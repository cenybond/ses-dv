---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/page-hero.astro';
import {ui,company} from '../data';
import {pageui} from '../data/ui';
---
<BaseLayout title={`${ui.notFound.title} — ${company.name.text}`} description={pageui.errormeta}>
  <PageHero title={ui.notFound.title} eyebrow={pageui.errorcode} lead={ui.notFound.lead} />
  <section class="container page-error">
    <p class="page-error__number" aria-hidden="true">{pageui.errorcode}</p>
    <div><h2>{pageui.errorheading}</h2><nav class="page-jumpnav" aria-label="Навигация со страницы ошибки"><a href="/">{pageui.home}</a><a href="/services">{ui.nav.services}</a><a href="/projects">{ui.nav.projects}</a><a href="/contacts">{ui.nav.contacts}</a></nav></div>
  </section>
</BaseLayout>
