# Формы выключены: никаких персональных данных или реальных секретов.
ASTRO_TELEMETRY_DISABLED=1
PUBLIC_SITE_MODE=staging
PUBLIC_SITE_URL=https://ses-dv.ru
PUBLIC_ANALYTICS_ENABLED=false
# Счётчик Яндекс Метрики сайта (идентификатор открытый, не секрет). Работает только вместе с PUBLIC_ANALYTICS_ENABLED=true, режимом production, утверждёнными юридическими текстами и согласием посетителя.
PUBLIC_METRICA_ID=114386722
PUBLIC_FORMS_ENABLED=false
PUBLIC_LEGAL_APPROVED=false
PUBLIC_CONSENT_VERSION=
LEADS_ENABLED=false
LEADS_LEGAL_APPROVED=false
LEADS_CONSENT_VERSION=
LEADS_ORIGIN=
LEADS_PORT=4322
LEADS_ENV=production
# Только адреса явно доверенного reverse proxy; он обязан перезаписывать X-Real-IP.
LEADS_TRUSTED_PROXY_IPS=
