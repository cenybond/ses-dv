{
  "name": "ses-dv-demo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "sync-theme": "node scripts/sync-theme.mjs",
    "dev": "node scripts/sync-theme.mjs && astro dev",
    "build": "node scripts/sync-theme.mjs && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "check-tokens": "node scripts/check-tokens.mjs",
    "check-copy": "node --disable-warning=ExperimentalWarning scripts/check-copy.mjs",
    "test-check-copy": "node --disable-warning=ExperimentalWarning scripts/test-check-copy.mjs",
    "check-dist": "node scripts/check-dist.mjs",
    "check-links": "node scripts/check-links.mjs",
    "test-check-links": "node scripts/test-check-links.mjs",
    "check-browser": "node scripts/check-browser.mjs",
    "verify": "npm run check && npm run build && npm run check-tokens && npm run check-copy && npm run test-check-copy && npm run check-dist && npm run check-links && npm run test-check-links && npm run check-browser && npm run test-forms && npm run test-privacy && npm run check-seo && npm run test-staging && npm run test-publications && npm run check-consent-browser",
    "test-forms": "node --test --test-timeout=30000 scripts/test-forms.mjs",
    "test-privacy": "node scripts/test-privacy.mjs",
    "check-seo": "node scripts/check-seo.mjs",
    "test-staging": "node scripts/test-staging.mjs",
    "staging:serve": "node scripts/serve-staging.mjs",
    "leads:serve": "node --env-file-if-exists=.env server/index.mjs",
    "test-publications": "node scripts/test-publications.mjs",
    "check-consent-browser": "node scripts/check-consent-browser.mjs"
  }
}
