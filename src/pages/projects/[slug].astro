---
import type { GetStaticPaths } from 'astro';
import type {Project,ProjectDetail} from '../../data/types';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/page-hero.astro';
import ProjectGallery from '../../components/project-gallery.astro';
import ContactBlock from '../../components/contact-block.astro';
import RequestButton from '../../components/request-button.astro';
import {projects,projectdetails,services,ui} from '../../data';
import {pageui} from '../../data/ui';
export const getStaticPaths = (() => projects.filter(project=>project.slug!=='tlt').map(project => ({params:{slug:project.slug},props:{project,detail:projectdetails.find(detail=>detail.id===project.id)!}}))) satisfies GetStaticPaths;
interface Props {project:Project;detail:ProjectDetail}
const {project,detail}=Astro.props;
const current=projects.findIndex(item=>item.id===project.id);
const previous=projects[(current+projects.length-1)%projects.length];
const next=projects[(current+1)%projects.length];
const related=project.serviceLinks.filter(link=>link.clientApproved).map(link=>services.find(service=>service.id===link.serviceId)).filter(Boolean);
---
<BaseLayout title={`${project.title.text} — СЭС`} description={detail.heading.text}>
  <PageHero title={detail.heading.text} eyebrow={pageui.project} compact breadcrumbs={[{label:ui.nav.projects,href:'/projects'},{label:pageui.project}]} />
  <article class="container page-section page-section--flush">
    <div class="project-detail">
      <aside class="project-detail__aside">
        <a class="page-inline-link" href="/projects"><span aria-hidden="true">←</span> {ui.actions.toCatalog}</a>
        <p>{pageui.projectsource}</p>
        <RequestButton context={`project:${project.id}`} label={ui.actions.discuss} />
      </aside>
      <div class="project-detail__content">
        {detail.sections.length>0 && <div class="project-prose">{detail.sections.map(section=><section>{section.heading&&<h2>{section.heading.text}</h2>}{section.paragraphs.map(paragraph=><p>{paragraph.text}</p>)}</section>)}</div>}
        {detail.galleries.length ? detail.galleries.map(gallery=><ProjectGallery title={gallery.title.text} />) : <ProjectGallery />}
        {related.length>0 && <section class="page-section"><h2>{pageui.related}</h2>{related.map(service=>service&&<a class="page-inline-link" href={`/services#${service.id}`}>{service.title.text}</a>)}</section>}
      </div>
    </div>
    <nav class="project-pager" aria-label={pageui.projectnavigation}>
      <a href={`/projects/${previous.slug}`}><span>{pageui.previous}</span>{previous.title.text}</a>
      <a href={`/projects/${next.slug}`}><span>{pageui.next}</span>{next.title.text}</a>
    </nav>
  </article>
  <ContactBlock context={`project:${project.id}`} />
</BaseLayout>
