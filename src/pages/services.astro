---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/page-hero.astro';
import ServiceCard from '../components/ServiceCard.astro';
import ContactBlock from '../components/contact-block.astro';
import {services,servicesPageTitle,ui,company} from '../data';
import {pageui} from '../data/ui';
---
<BaseLayout title={`${ui.nav.services} — ${company.name.text}`} description={pageui.servicesmeta}>
  <PageHero title={servicesPageTitle.text} eyebrow={company.descriptor.text} lead={pageui.serviceslead}>
    <nav class="page-jumpnav" aria-label={pageui.groupnavigation}>
      <a href="#s-01">{pageui.connection}</a><a href="#s-02">{pageui.electricity}</a><a href="#s-05">{pageui.engineering}</a><a href="#s-07">{pageui.construction}</a><a href="#s-10">{services[9].title.text}</a>
    </nav>
  </PageHero>
  <section class="container page-section page-section--flush" aria-label={pageui.serviceheading}>
    <ul class="service-catalog" role="list">{services.map((service,index) => <ServiceCard level={2} id={service.id} number={String(index+1).padStart(2,'0')} title={service.title.text} descriptionPending={service.descriptionStatus==='DESCRIPTION_PENDING'} />)}</ul>
  </section>
  <ContactBlock />
</BaseLayout>
