---
// Карточка услуги (DESIGN-SYSTEM §8.4): название дословно, номер интерфейсный. Без описания — «Описание будет добавлено».
// «Заказать» открывает диалог заявки (DEMO-05); data-атрибуты уже соответствуют контракту system.js.
import { ui } from '../data';

interface Props {
  number: string;
  title: string;
  descriptionPending?: boolean;
}
const { number, title, descriptionPending = false } = Astro.props;
---
<li>
  <button class="service" type="button" data-open-request data-context="Услуга" data-subject={title}>
    <span class="num" aria-hidden="true">{number}</span>
    <span class="service__title">{title}</span>
    {descriptionPending && <span class="service__pending">{ui.placeholders.serviceDescription}</span>}
    <span class="service__act">{ui.actions.order} <span class="dot" aria-hidden="true"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></span>
  </button>
</li>
