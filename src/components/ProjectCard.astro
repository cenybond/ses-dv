---
import {pageui} from '../data/ui';
interface Props { title: string; href?: string; photoSrc?: string; photoAlt?: string; level?: 2 | 3 }
const {title,href,photoSrc,photoAlt = '',level=3} = Astro.props;
---
<li class="project-card">
  {href ? <a class="project-card__link" href={href} data-goal="project_open">
    <div class="project-card__photo">{photoSrc ? <img src={photoSrc} alt={photoAlt} loading="lazy" /> : <span>{pageui.photo}</span>}</div>
    <div class="project-card__body">{level===2?<h2 class="project-card__title">{title}</h2>:<h3 class="project-card__title">{title}</h3>}<span class="project-card__arrow" aria-hidden="true">↗</span></div>
  </a> : <div class="project-card__link">
    <div class="project-card__photo"><span>{pageui.photo}</span></div>
    <div class="project-card__body">{level===2?<h2 class="project-card__title">{title}</h2>:<h3 class="project-card__title">{title}</h3>}</div>
  </div>}
</li>
