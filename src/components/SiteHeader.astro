---
// Шапка (DESIGN-SYSTEM §8.1). `solid` — внутренние страницы без hero: светлая всегда (класс уже в разметке, без JS шапка читаема);
// `overlay` — прозрачная над hero (главная, DEMO-06): hero сам уходит под шапку отрицательным margin-top, светлой она становится при прокрутке.
// «Связаться с нами» ведёт на /contacts (на главной — плавно к блоку контактов, scripts/forms.ts). Кнопка «Меню» — якорь на навигацию в подвале; с JS открывает шторку (scripts/mobile-menu.ts).
import Logo from './Logo.astro';
import ContactLink from './ContactLink.astro';
import NavigationLink from './NavigationLink.astro';
import { phones, ui, mainNav, routes } from '../data';

interface Props {
  variant?: 'solid' | 'overlay' | 'hero';
  currentPath?: string;
}
const { variant = 'solid', currentPath = '' } = Astro.props;
---
<header class:list={['site-header', variant !== 'overlay' && 'is-solid', variant === 'hero' && 'site-header--hero']} id="top" data-header={variant !== 'overlay' ? 'solid' : ''}>
  <div class="container site-header__row">
    <Logo variant={variant === 'hero' ? 'horizontal' : 'wordmark'} />
    <nav class="nav" aria-label={ui.a11y.mainNav}>
      <ul>
        <li><NavigationLink href="/" label="Главная" currentPath={currentPath} /></li>
        {mainNav.map((item) => <li><NavigationLink href={item.href} label={item.label} currentPath={currentPath} /></li>)}
      </ul>
    </nav>
    <div class="site-header__actions">
      <ContactLink class="header-phone" href={phones[0].href} label={phones[0].display.text} />
      <a class="btn btn--lime request-button" href={routes.contacts} data-contacts-link>{ui.actions.contactUs}</a>
      <a class="burger" href="#site-nav" data-open-menu aria-label={ui.a11y.menu}>
        <span class="burger__bars" aria-hidden="true"></span>
      </a>
    </div>
  </div>
</header>
