---
// Заготовка страницы до её фазы (DEMO-06…12): один H1, честная пометка «содержимое появится позже», без вымышленных данных.
// Шапка, подвал и навигация — из BaseLayout, здесь не дублируются.
import Container from './Container.astro';
import { ui } from '../data';

interface Props {
  title: string;
  lead?: string;
}
const { title, lead } = Astro.props;
---
<Container class="page-head">
  <h1 class="page-head__title">{title}</h1>
  {lead && <p class="page-head__lead">{lead}</p>}
</Container>
<Container>
  <p class="stub-note" role="note">{ui.stub.note}</p>
  <slot />
</Container>
