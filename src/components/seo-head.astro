---
import { company } from '../data/source/company';
import { site_config, page_indexable } from '../data/site-config';
interface Props { title: string; description: string; path: string; }
const { title, description, path } = Astro.props;
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = new URL(`${basePath}${path}`, site_config.origin).href;
const schema = {
  '@context': 'https://schema.org', '@type': 'Organization',
  '@id': `${site_config.origin}/#organization`, name: company.name.text, url: site_config.origin,
};
const serialized = JSON.stringify(schema).replace(/</g, '\\u003c');
---
<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={page_indexable(path) ? 'index, follow' : 'noindex, nofollow'} />
<link rel="canonical" href={canonical} />
<meta property="og:type" content="website" />
<meta property="og:locale" content="ru_RU" />
<meta property="og:site_name" content="Связь Энергострой" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<script is:inline type="application/ld+json" set:html={serialized} />
