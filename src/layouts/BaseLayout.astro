---
// Оболочка страницы: head (noindex в демо, favicon), skip-link, полоса демо, шапка, <main>, подвал.
// Меню-шторка и нижняя панель — общие для всех страниц; диалог заявки добавляется в DEMO-05.
import '../styles/global.css';
// Значок вкладки браузера — полный знак (решение владельца 2026-11-18), а не только верхняя часть.
import favicon from '../../design/system/logo/logo-mark-square.svg?url';
// Кириллица Inter — шрифт H1 hero главной: заранее загружаем, чтобы заголовок первого экрана не перерисовывался после подмены шрифта.
import interCyrillic from '../../design/system/fonts/inter-cyrillic-wght-normal.woff2?url';
import SkipLink from '../components/SkipLink.astro';
import SeoHead from '../components/seo-head.astro';
import CookieBanner from '../components/cookie-banner.astro';
import CookieSettings from '../components/cookie-settings.astro';
import RequestDialog from '../components/request-dialog.astro';
import SiteHeader from '../components/SiteHeader.astro';
import MobileMenu from '../components/MobileMenu.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { normalizePath } from '../data';

interface Props {
  title: string;
  description: string;
  headerVariant?: 'solid' | 'overlay' | 'hero';
  /** Отдельная страница без шапки, подвала, меню и нижней панели (страница 404). */
  bare?: boolean;
}
const { title, description, headerVariant = 'solid', bare = false } = Astro.props;
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const pathname = Astro.url.pathname;
const currentPath = normalizePath(basePath && (pathname === basePath || pathname.startsWith(basePath + '/')) ? pathname.slice(basePath.length) || '/' : pathname);
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <SeoHead title={title} description={description} path={currentPath} />
    <link rel="icon" href={favicon} type="image/svg+xml" />
    {headerVariant === 'hero' && <link rel="preload" href={interCyrillic} as="font" type="font/woff2" crossorigin />}
  </head>
  <body class={bare ? 'page-bare' : undefined}>
    {!bare && <SkipLink />}
    {!bare && <SiteHeader variant={headerVariant} currentPath={currentPath} />}
    <main id="main" tabindex="-1">
      <slot />
    </main>
    {!bare && <SiteFooter currentPath={currentPath} />}
    {!bare && <MobileMenu currentPath={currentPath} />}
    {!bare && <RequestDialog />}
    {import.meta.env.PUBLIC_PAGES_PREVIEW !== 'true' && <CookieBanner />}
    {import.meta.env.PUBLIC_PAGES_PREVIEW !== 'true' && <CookieSettings />}
    <script>
      import '../scripts/site.ts';
      import '../scripts/forms.ts';
    </script>
  </body>
</html>
