---
// Контейнер сетки: ширина --container (1200 px), боковые поля --gutter. Стили — `.container` из design/system/system.css.
interface Props {
  as?: 'div' | 'section' | 'header' | 'footer';
  class?: string;
}
const { as: Tag = 'div', class: className = '' } = Astro.props;
---
<Tag class:list={['container', className]}><slot /></Tag>
