---
// Кнопки и ссылки-кнопки системы (DESIGN-SYSTEM §8.3). Переход — <a> (есть href), действие — <button>.
interface Props {
  variant?: 'lime' | 'ghost-dark' | 'ghost-light' | 'text-light';
  size?: 'sm' | 'md' | 'lg';
  href?: string;
  block?: boolean;
  arrow?: boolean;
  type?: 'button' | 'submit';
  class?: string;
}
const { variant = 'lime', size = 'md', href, block = false, arrow = false, type = 'button', class: className = '' } = Astro.props;
const classes = ['btn', `btn--${variant}`, size !== 'md' && `btn--${size}`, block && 'btn--block', className];
---
{href ? (
  <a class:list={classes} href={href}>
    <slot />
    {arrow && <span class="btn__arrow" aria-hidden="true"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>}
  </a>
) : (
  <button class:list={classes} type={type}>
    <slot />
    {arrow && <span class="btn__arrow" aria-hidden="true"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>}
  </button>
)}
