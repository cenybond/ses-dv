---
// Подвал: четыре колонки по сетке сайта (описание, контакты, разделы, информация) и крупный декоративный знак внизу на всю ширину.
// Знак — пять фигур по мотиву знака компании (не сам логотип и не его растяжение): равные зазоры, единый наклон кровель, цвета из токенов.
// Показана верхняя часть фигур (низ обрезан), колонки растянуты между полями 72 px — те же, что у заголовка hero.
import ContactLink from './ContactLink.astro';
import NavigationLink from './NavigationLink.astro';
import { company, phones, email, ui, mainNav, privacyRoute, vacanciesExternalUrl } from '../data';
import { published_routes } from '../data/publications';
interface Props { currentPath?: string; }
const { currentPath = '' } = Astro.props;
---
<footer class="site-footer on-dark">
  <div class="footer__wrap">
    <div class="footer__grid">
      <div class="footer__brand"><p class="footer__lead">{company.descriptor.text}</p><p class="footer__muted">{company.name.text}</p></div>
      <div class="footer__col"><h2 class="footer__h">{ui.nav.contactsHeading}</h2><ul>
        {phones.map(phone => <li><ContactLink href={phone.href} label={phone.display.text} /></li>)}
        <li><ContactLink href={email.href} label={email.display.text} /></li>
      </ul></div>
      <nav class="footer__col" id="site-nav" aria-label={ui.a11y.footerNav} tabindex="-1"><h2 class="footer__h">{ui.nav.footerHeading}</h2><ul>
        {mainNav.map(item => <li><NavigationLink href={item.href} label={item.label} currentPath={currentPath} /></li>)}
        <li><a href={vacanciesExternalUrl} target="_blank" rel="noopener noreferrer">{ui.nav.vacancies}</a></li>
        {published_routes.includes('/news') && <li><NavigationLink href="/news" label="Новости" currentPath={currentPath} /></li>}
        {published_routes.includes('/documents') && <li><NavigationLink href="/documents" label="Документы" currentPath={currentPath} /></li>}
      </ul></nav>
      <div class="footer__col"><h2 class="footer__h">Информация</h2><ul>
        <li><NavigationLink href="/cookies" label="Куки и аналитика" currentPath={currentPath} /></li>
        <li><NavigationLink href={privacyRoute.href} label={privacyRoute.label} currentPath={currentPath} /></li>
      </ul></div>
    </div>
  </div>
  <svg class="footer__mark" viewBox="0 0 1200 200" aria-hidden="true" focusable="false">
    <path class="footer__mark-side" d="M38.5 200L283 111V200Z" />
    <path class="footer__mark-mid" d="M321 200V102L448 56V200Z" />
    <path class="footer__mark-core" d="M486 200V42L600 0L714 42V200Z" />
    <path class="footer__mark-mid" d="M752 200V56L879 102V200Z" />
    <path class="footer__mark-side" d="M1161.5 200L917 111V200Z" />
  </svg>
</footer>
