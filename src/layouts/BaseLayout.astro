---
// Оболочка страницы: head (noindex в демо, favicon), skip-link, полоса демо, шапка, <main>, подвал.
// Меню-шторка и нижняя панель — общие для всех страниц; диалог заявки добавляется в DEMO-05.
import '../styles/global.css';
import favicon from '../../design/system/logo/favicon.svg?url';
import SkipLink from '../components/SkipLink.astro';
import SeoHead from '../components/seo-head.astro';
import CookieBanner from '../components/cookie-banner.astro';
import CookieSettings from '../components/cookie-settings.astro';
import RequestDialog from '../components/request-dialog.astro';
import SiteHeader from '../components/SiteHeader.astro';
import MobileMenu from '../components/MobileMenu.astro';
import MobileBottomBar from '../components/MobileBottomBar.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { normalizePath } from '../data';

interface Props {
  title: string;
  description: string;
  headerVariant?: 'solid' | 'overlay';
}
const { title, description, headerVariant = 'solid' } = Astro.props;
const currentPath = normalizePath(Astro.url.pathname);
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <SeoHead title={title} description={description} path={currentPath} />
    <link rel="icon" href={favicon} type="image/svg+xml" />
  </head>
  <body>
    <SkipLink />
    <SiteHeader variant={headerVariant} currentPath={currentPath} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter currentPath={currentPath} />
    <MobileMenu currentPath={currentPath} />
    <MobileBottomBar />
    <RequestDialog />
    <CookieBanner />
    <CookieSettings />
    <script>
      import '../scripts/site.ts';
      import '../scripts/forms.ts';
    </script>
  </body>
</html>
