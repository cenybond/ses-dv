---
// Подвал (DESIGN-SYSTEM §8.2): полный знак на тёмном, разделы, контакты, пометка демо. «Вакансии» — недоступная строка (не ссылка).
import Logo from './Logo.astro';
import ContactLink from './ContactLink.astro';
import { company, phones, email, ui, mainNav, privacyRoute } from '../data';
---
<footer class="site-footer on-dark">
  <div class="container">
    <div class="footer__grid">
      <div class="footer__brand">
        <Logo variant="full-on-dark" />
        <p>{company.name.text}</p>
        <p class="footer__muted">{company.descriptor.text}</p>
      </div>
      <nav class="footer__col" id="site-nav" aria-label={ui.a11y.footerNav} tabindex="-1">
        <h2 class="footer__h">{ui.nav.footerHeading}</h2>
        <ul>
          {mainNav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
          <li><span class="off">{ui.nav.vacancies} <span class="badge badge--on-dark">{ui.placeholders.feature}</span></span></li>
        </ul>
      </nav>
      <div class="footer__col">
        <h2 class="footer__h">{ui.nav.contactsHeading}</h2>
        <ul>
          {phones.map((p) => <li><ContactLink href={p.href} label={p.display.text} /></li>)}
          <li><ContactLink href={email.href} label={email.display.text} /></li>
          <li><span class="footer__muted">{ui.placeholders.address}</span></li>
        </ul>
      </div>
      <div class="footer__col">
        <h2 class="footer__h">{ui.demo.title}</h2>
        <p class="footer__muted">{ui.demo.text}</p>
      </div>
    </div>
    <div class="footer__bottom">
      <p>{company.name.text}</p>
      <a class="link-inline link-inline--light" href={privacyRoute.href}>{privacyRoute.label}</a>
    </div>
  </div>
</footer>
